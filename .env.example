# Server-only settings. Never put credentials in VITE_ variables.
# Local runs automatically read the existing parent workspace .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
NEWSROOM_TIMEZONE=Europe/London
# Optional bearer token for legacy scripts; browser requests use account sessions.
NEWSROOM_ADMIN_TOKEN=
# Stripe server-only configuration. Accepts sk_test_/rk_test_ and sk_live_/rk_live_.
# Both live prefixes require an HTTPS PUBLIC_APP_URL. Start with test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:8788
# DATABASE_URL=postgresql+psycopg://user:password@localhost/newsroom

# Keep false for private/local use. First owner must always register locally.
NEWSROOM_ALLOW_REMOTE_REGISTRATION=false

# Vercel ingress + persistent backend only. Same random value on both services.
# Generate locally with Python secrets.token_hex(32); never put it in VITE_ vars.
NEWSROOM_PROXY_SECRET=

# Vercel native runtime only. Store these as server Secrets in the project.
# VERCEL is set by the platform; it selects durable PostgreSQL and /tmp scratch.
NEWSROOM_CSRF_SECRET=
CRON_SECRET=
